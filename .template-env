# Template .env file : put the real .env in the same directory
# What `dot` reads for this machine (bootstrap writes it; without one, dot uses the hostname)
# NIXTYPE : the archetype, one of nixos, nixos-wsl, nix-darwin (a directory in vg-dotfiles/nix)
# NIXCONFIG : the top-level configuration name in flake.nix to activate
# NIXCONFIG_VERSION : the lts nixpkgs version in which to use, to get the approriate nixos package or update the channel
# NIXCONFIG_USERNAME : the username for the nix config, to get home manager options using `nix eval`
NIXTYPE=nix-darwin
NIXCONFIG=vgmacbook
NIXCONFIG_VERSION=26.05
NIXCONFIG_USERNAME=vaibhav
