# ─── mako : notifications ─── Kanagawa Dragon ───────────────────────────────
# Reload after editing: makoctl reload

font=JetBrainsMono Nerd Font 11
background-color=#181616e6
text-color=#c5c9c5
border-color=#8ba4b0
progress-color=over #2d4f67

anchor=top-right
layer=overlay
width=360
margin=12
padding=12
border-size=2
border-radius=12
max-visible=5
default-timeout=5000
icons=1
max-icon-size=48

[urgency=low]
border-color=#625e5a

[urgency=high]
border-color=#c4746e
default-timeout=0

# SUPER + SHIFT + N, or the bell on the bar
[mode=do-not-disturb]
invisible=1
