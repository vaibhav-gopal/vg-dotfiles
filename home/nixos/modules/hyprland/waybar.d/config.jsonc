{
  "layer": "top",
  "position": "top",
  "height": 34,
  "margin-top": 8,
  "margin-left": 10,
  "margin-right": 10,
  "spacing": 2,
  "reload_style_on_change": true,

  "modules-left": ["custom/kraken", "hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": [
    "tray",
    "custom/dnd",
    "custom/nightlight",
    "cpu",
    "memory",
    "wireplumber",
    "backlight",
    "network",
    "bluetooth",
    "battery",
    "custom/power"
  ],

  "custom/kraken": {
    "format": "",
    "tooltip-format": "vgkraken · left: apps · right: keybinds",
    "on-click": "fuzzel",
    "on-click-right": "bash ~/.config/hypr/scripts/cheatsheet.sh"
  },

  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "1": "一", "2": "二", "3": "三", "4": "四", "5": "五",
      "6": "六", "7": "七", "8": "八", "9": "九", "10": "十"
    },
    "persistent-workspaces": { "*": 5 },
    "on-scroll-up": "hyprctl dispatch workspace e-1",
    "on-scroll-down": "hyprctl dispatch workspace e+1"
  },

  "hyprland/window": {
    "format": "{title}",
    "max-length": 48,
    "separate-outputs": true
  },

  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%A, %d %B %Y}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "right",
      "format": {
        "months": "<span color='#c4b28a'><b>{}</b></span>",
        "days": "<span color='#c5c9c5'>{}</span>",
        "weeks": "<span color='#625e5a'>W{}</span>",
        "weekdays": "<span color='#8ba4b0'><b>{}</b></span>",
        "today": "<span color='#ff9e3b'><b><u>{}</u></b></span>"
      }
    }
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8
  },

  "custom/dnd": {
    "exec": "bash ~/.config/hypr/scripts/dnd.sh status",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "on-click": "bash ~/.config/hypr/scripts/dnd.sh toggle"
  },

  "custom/nightlight": {
    "exec": "bash ~/.config/hypr/scripts/nightlight.sh status",
    "return-type": "json",
    "interval": "once",
    "signal": 9,
    "on-click": "bash ~/.config/hypr/scripts/nightlight.sh toggle"
  },

  "cpu": {
    "format": "  {usage}%",
    "interval": 5,
    "on-click": "uwsm app -- kitty --class floating-tui -e btm"
  },

  "memory": {
    "format": "  {percentage}%",
    "interval": 10,
    "tooltip-format": "{used:0.1f} / {total:0.1f} GiB",
    "on-click": "uwsm app -- kitty --class floating-tui -e btm"
  },

  "wireplumber": {
    "format": "{icon}  {volume}%",
    "format-muted": "  muted",
    "format-icons": ["", "", ""],
    "scroll-step": 5,
    "on-click": "uwsm app -- kitty --class floating-tui -e wiremix",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },

  "backlight": {
    "format": "  {percent}%",
    "on-scroll-up": "brightnessctl -e4 -n2 set 5%+",
    "on-scroll-down": "brightnessctl -e4 -n2 set 5%-"
  },

  "network": {
    "format-wifi": "  {essid}",
    "format-ethernet": "  wired",
    "format-disconnected": "  offline",
    "tooltip-format-wifi": "{essid} ({signalStrength}%) · {ipaddr}",
    "tooltip-format-ethernet": "{ifname} · {ipaddr}",
    "on-click": "uwsm app -- kitty --class floating-tui -e nmtui"
  },

  "bluetooth": {
    "format": "",
    "format-disabled": "",
    "format-connected": "  {device_alias}",
    "tooltip-format": "{controller_alias} · {status}",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "on-click": "uwsm app -- kitty --class floating-tui -e bluetui"
  },

  "battery": {
    "states": { "warning": 25, "critical": 10 },
    "format": "{icon}  {capacity}%",
    "format-charging": "  {capacity}%",
    "format-plugged": "  {capacity}%",
    "format-icons": ["", "", "", "", ""]
  },

  "custom/power": {
    "format": "",
    "tooltip-format": "power menu",
    "on-click": "bash ~/.config/hypr/scripts/powermenu.sh"
  }
}
